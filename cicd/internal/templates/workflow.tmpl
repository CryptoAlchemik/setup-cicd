name: CI/CD Pipeline

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

env:
  REGISTRY: ghcr.io
  DEPLOY_USER: {{ .DeployUser }}
  DEPLOY_DIR: {{ .DeployDir }}

jobs:

  ci:
    name: CI
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Docker build smoke-test
        run: docker build -t app:ci-test .

{{ range .Stages }}
  deploy-{{ .Name }}:
    name: "Deploy → {{ .Name }}"
    runs-on: ubuntu-latest
    needs: ci
    if: github.ref == 'refs/heads/{{ .Branch }}' && github.event_name == 'push'
    environment: {{ .Name }}
    permissions:
      contents: read
      packages: write

    steps:
      - uses: actions/checkout@v4

      - name: Lowercase image name
        run: echo "IMAGE_NAME=${GITHUB_REPOSITORY,,}" >> $GITHUB_ENV

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: ${{"{{"}} github.actor {{"}}"}}
          password: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}

      - name: Build and push → {{ .Name }}
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}:{{ .Name }}-latest
            ${{"{{"}} env.REGISTRY {{"}}"}}/${{"{{"}} env.IMAGE_NAME {{"}}"}}:{{ .Name }}-${{"{{"}} github.sha {{"}}"}}

      - name: Setup SSH agent
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{"{{"}} secrets.SSH_PRIVATE_KEY_{{ .Upper }} {{"}}"}}

      - name: Add server to known hosts
        run: ssh-keyscan -H ${{"{{"}} secrets.SSH_HOST_{{ .Upper }} {{"}}"}} >> ~/.ssh/known_hosts

      - name: Deploy via SSH
        env:
          SSH_HOST: ${{"{{"}} secrets.SSH_HOST_{{ .Upper }} {{"}}"}}
          GHCR_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
          ACTOR: ${{"{{"}} github.actor {{"}}"}}
        run: |
          ssh -p 22 {{ $.DeployUser }}@$SSH_HOST bash << EOF
            set -e
            echo "$GHCR_TOKEN" | docker login ghcr.io -u $ACTOR --password-stdin
            cd {{ $.DeployDir }}
            docker compose -f docker-compose.{{ .Name }}.yml pull
            docker compose -f docker-compose.{{ .Name }}.yml up -d --remove-orphans
            docker image prune -f
          EOF
{{ end }}
